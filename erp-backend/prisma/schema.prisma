// =====================================================================
// Consort CRM — Prisma schema
// Source of truth: docs/DATABASE.md (subordinate to DECISIONS.md /
// BUSINESS_RULES.md). Every model/column serves a cited rule or ADR.
//
// NOTE: constraints Prisma cannot express (partial unique indexes for
// INV-05/07/08, services non-empty CHECKs, one-target CHECKs, the
// ADR-038 hold-pair CHECK, lower(email) unique) are applied in a raw
// SQL migration — see docs/DATABASE.md §5.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================

// Management tier (ceo..gm) holds identical permissions (ADR-044)
enum UserRole {
  ceo
  project_director
  director
  cfo
  gm
  hr
  asm
  bdo
  ops_manager
  ops_exec
  compliance_manager
  compliance_exec
  transport_manager
  transport_exec
  accounts
  // Owns the WEBSITE query channel: queries raised via the storefront/portal
  // (raisedVia = portal) that no BDO raised — reads, updates and carries their
  // quotes, scoped to that channel only.
  web_manager
  customer
}

enum DepartmentCode {
  management
  sales
  operations
  compliance
  finance
  hr
  transport
}

// ADR-042 — immutable after creation (INV-13)
enum LeadSource {
  bdo
  bank_lc
  direct
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

enum OutreachType {
  call
  email
  meeting
  whatsapp
  linkedin
  site_visit
}

enum OutreachOutcome {
  positive
  neutral
  negative
  no_response
}

// ADR-043, WORKFLOW §2a
enum VisitPlanStatus {
  planned
  completed
  cancelled
  no_show
}

enum QueryStatus {
  open
  quoted
  revision_requested
  approved
  shipment_created
  rejected
  cancelled
  expired
}

// The query's intake channel — the three buckets the Queries screen filters by:
//   bdo     raised internally by sales (BDO/ASM)
//   portal  the website channel — storefront signup / portal customer
//   bank_lc materialized from a bank LC referral (§5.21)
enum RaisedVia {
  bdo
  portal
  bank_lc
}

// Revisions are new rows, not a status (ADR-019)
enum QuotationStatus {
  draft
  sent
  approved
  rejected
  expired
}

enum ApprovalChannel {
  customer_portal
  asm
  management
}

// How the BDO relayed a sent quote to the customer (email, call, WhatsApp, face to face)
enum QuoteShareChannel {
  email
  phone
  whatsapp
  in_person
}

// ADR-041 — the Phase-1 catalog, closed
enum ServiceCode {
  local_transport
  customs_clearance
  sea_freight
  port_handling
  lc_finance
  destination_services // destination agent: DO + gate pass, destination pickup, delivery, empty return
}

// Step codes are plain strings since ADR-051, so the Workflow admin panel can mint new
// steps without a schema change. Format is guarded by otd_step_templates_code_format in
// prisma/sql/constraints.sql (^[a-z][a-z0-9_]{1,49}$) and by the workflow module's Zod.
// The catalog itself lives in otd_step_templates; ADR-003's canonical codes are seeded
// there (prisma/seed.js) and historical rows resolve by step_code forever — which is why
// a used step is deactivated, never deleted, and its code is immutable.

// A step's sub-action is either ticked by its owner or satisfied by evidence.
// `document` actions are DERIVED, never written — satisfaction is the presence of a
// live document of that type on the shipment, exactly like RULE-SH-06 (ADR-048).
enum StepActionKind {
  manual
  document

  @@map("step_action_kind")
}

// reopen returns a step to pending (RULE-SH-05)
enum OtdStepStatus {
  pending
  done
}

// ── Trade shipments (Export Shipment Workflow roadmap §1, §7) ─────────────────
// How a shipment was BORN. `forwarding` is the original path — from an approved
// quotation (INV-03). `trade` is the roadmap's path: a Trade Contract plus a
// Financial Instrument registered at the vendor's bank, both of which exist BEFORE
// any shipment does, so a trade shipment has no quotation to originate from.
enum ShipmentKind {
  forwarding
  trade

  @@map("shipment_kind")
}

// Export vs Import is a per-SHIPMENT fact, never a property of a party (roadmap §1,
// Examples 1 & 2: Consort is Manufacturer on the Zanitex export and Freight Forwarder
// on the Chenab import).
enum ShipmentDirection {
  export
  import

  @@map("shipment_direction")
}

// The role a party plays ON ONE SHIPMENT. Deliberately NOT `VendorType`, which stays a
// default hint on the vendor record: the same company is Exporter on one shipment and
// Freight Forwarder on the next, and the roadmap forbids fixing it per company.
enum PartyRole {
  customer
  manufacturer
  vendor
  exporter
  buyer
  notify_party
  bank
  ocean_carrier
  carrier_agent
  freight_forwarder
  port_terminal
  clearing_agent
  destination_agent
  transporter
  other

  @@map("party_role")
}

// ── Export trade documents (Export Shipment Workflow roadmap §4/§7) ───────────

// The roadmap §7.1 workflow states. DERIVED from which documents exist, never
// written by an endpoint — the same rule ADR-014 applies to ShipmentStatus.
enum TradeStage {
  none
  contract_registered
  fi_active
  packing_list_confirmed
  commercial_invoice_raised
  booking_confirmed
  shipped_on_board
  logistics_settled
  payment_realised
  fi_closed

  @@map("trade_stage")
}

enum TradeContractStatus {
  draft
  active
  completed
  cancelled

  @@map("trade_contract_status")
}

// The roadmap sample instruments are bank EXP registrations (BIP-EXP-…), but the
// same record shape carries an LC or a documentary collection, so the type is a
// column rather than a separate table.
enum FinancialInstrumentType {
  exp_form
  lc
  dp
  da
  advance
  open_account

  @@map("financial_instrument_type")
}

enum FinancialInstrumentStatus {
  draft
  active
  expired
  closed
  cancelled

  @@map("financial_instrument_status")
}

// Which way the goods invoice points. `purchase` is the vendor billing Consort —
// the only one present in the roadmap sample documents. `sale` is Consort billing
// the customer, and is what makes the margin on goods computable.
enum TradeInvoiceSide {
  purchase
  sale

  @@map("trade_invoice_side")
}

enum TradeInvoiceStatus {
  draft
  issued
  void

  @@map("trade_invoice_status")
}

enum FreightTerms {
  prepaid
  collect

  @@map("freight_terms")
}

enum BolType {
  master
  house

  @@map("bol_type")
}

// Progressive values; DERIVED, never written by an endpoint (ADR-014, INV-02).
// `container_allocated` / `destination_inspection` retained for historical rows (retired from the seed).
enum ShipmentStatus {
  booking
  order_confirmed
  lc_generated
  container_allocated
  vessel_booked
  cro_released
  transporter_assigned
  vehicle_dispatched
  goods_loaded
  in_transit
  empty_container_pickup
  cargo_pickup
  inland_transit
  customs_entry
  inspected_sealed
  port_handover
  bol_issued
  bol_submitted
  telex_released
  destination_inspection
  destination_do
  destination_pickup
  delivered
  settled
  closed
}

// Orthogonal to progress (RULE-SH-08)
enum ExceptionState {
  none
  on_hold
  cancelled
}

enum ExceptionType {
  customs_hold
  payment_hold
  documentation_hold
  weather_hold
  customer_request
  other
}

enum OtcMilestoneType {
  invoice_issued
  payment_received
  credit_line_released
  bol_surrendered
  settlement_complete
}

enum OtcMilestoneStatus {
  pending
  done
}

enum InvoiceStatus {
  draft
  issued
  part_paid
  paid
  void
}

enum PaymentMethod {
  bank_transfer
  cheque
  cash
  lc_settlement
  other
}

enum TaskStatus {
  queued
  open
  in_progress
  done
  cancelled
  on_hold
}

enum TaskOrigin {
  otd_step
  query_precheck
  ad_hoc
  system
}

enum DocumentOwnerType {
  shipment
  quotation
  query
  lead
  customer
  task
  chat_message
  // Master data — the paperwork that proves a counterparty or an asset is legal
  // to move cargo: a vendor's tax certificate, a driver's CNIC and licence, a
  // vehicle's registration. Internal-only (never portal-visible).
  vendor
  driver
  vehicle
  // The LC advice itself (the SWIFT MT700/710 printout the bank sends). It is the
  // source document the query is built from, so it hangs off the referral rather
  // than being re-keyed into columns and lost.
  lc_referral
}

enum ScanStatus {
  pending
  clean
  infected
}

enum ChannelType {
  shipment
  department
  general
  direct
}

// whatsapp is a Phase-1.5 stub
enum NotificationChannel {
  in_app
  email
  whatsapp
}

enum DeliveryStatus {
  queued
  sent
  failed
}

enum LoginOutcome {
  success
  invalid_credentials
  locked
  inactive
}

// ── Intake channel & public storefront (CRM_MASTER §5.20/§5.21) ──

// Bank LC Referral lifecycle (WORKFLOW §2c) — the *bank_lc* channel intake
enum BankLcStatus {
  received
  reviewing
  converted
  rejected
}

// Load board posting lifecycle (CRM_MASTER §5.20)
enum LoadBoardStatus {
  open
  booked
  expired
}

enum TransportMode {
  sea
  road
  air
  rail
}

// ── Vendors & job-charge ledger (freight-forwarding OTC upgrade) ──

enum VendorType {
  transporter
  shipping_line
  container_yard
  customs_agent
  destination_agent
  port_terminal
  rail_operator
  freight_forwarder
  ocean_carrier
  exporter
  buyer
  bank
  driver
  other
}

// Inland leg mode. Deliberately NOT TransportMode (sea/road/air/rail): a query's
// inland leg is only ever truck or rail, and the narrower enum keeps bad values out.
enum InlandMode {
  truck
  rail
}

// The three legs of a rail-mode inland journey. A VendorRfq with a null leg covers
// the whole service (truck inland, or any non-transport service).
enum RfqLeg {
  first_mile // truck: pickup → origin rail terminal
  middle_mile // rail: terminal → terminal
  last_mile // truck: destination rail terminal → delivery
}

// Own fleet assets. Trucks and dumpers carry the same record shape and differ
// only in what they haul, so they are one table behind two filtered views.
enum VehicleKind {
  truck
  dumper
}

enum ChargeDirection {
  receivable // money IN — customer side
  payable // money OUT — vendor side
}

// ── Vendor rate requests (RFQ) ──
// Consort owns no vessels, trucks or line, so every cost on a job is bought from
// a vendor. An RFQ is one ask, for one service on one query, sent to N vendors.

enum RfqStatus {
  open
  awarded // a winning vendor quote has been picked
  cancelled
}

enum VendorQuoteStatus {
  pending // vendor asked, nothing back yet
  quoted // rates received and typed in by ops
  declined // vendor passed on the job
}

// ================= IDENTITY & ORGANISATION =================

model Department {
  id         String         @id @default(uuid())
  code       DepartmentCode @unique
  name       String
  headUserId String?        @map("head_user_id") // departments.head_user_id (CRM_MASTER §4)
  head       User?          @relation("DepartmentHead", fields: [headUserId], references: [id])
  employees  Employee[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("departments")
}

model Employee {
  id           String     @id @default(uuid())
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  email        String     @unique // work email, may differ from login
  phone        String?
  cnic         String?    @unique // national ID
  designation  String?
  departmentId String     @map("department_id") // INV-01 — exactly one department
  department   Department @relation(fields: [departmentId], references: [id])
  managerId    String?    @map("manager_id") // cycle-checked in service (RULE-EMP-03)
  manager      Employee?  @relation("Reporting", fields: [managerId], references: [id])
  reports      Employee[] @relation("Reporting")
  joiningDate  DateTime?  @map("joining_date") @db.Date
  exitDate     DateTime?  @map("exit_date") @db.Date // set on deactivation (ADR-045)
  isActive     Boolean    @default(true) @map("is_active")
  user         User? // login is optional (CRM_MASTER §5.2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique // + raw unique index on lower(email) — DATABASE.md §5
  passwordHash       String?      @map("password_hash") // null until activation completes
  role               UserRole // PRIMARY role — display + customer detection; always present in `roles`
  roles              UserRole[]   @default([]) // an employee may hold several internal roles; permissions are the union
  employeeId         String?      @unique @map("employee_id") // internal users
  employee           Employee?    @relation(fields: [employeeId], references: [id])
  customerId         String?      @map("customer_id") // portal users (role = customer)
  customer           Customer?    @relation(fields: [customerId], references: [id])
  tokenVersion       Int          @default(0) @map("token_version") // global invalidation (ADR-009)
  isActive           Boolean      @default(true) @map("is_active")
  failedLoginCount   Int          @default(0) @map("failed_login_count")
  lockedUntil        DateTime?    @map("locked_until") // account lockout (ADR-033)
  lastLoginAt        DateTime?    @map("last_login_at")
  departmentsHeaded  Department[] @relation("DepartmentHead") // back-relation for departments.head_user_id
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([customerId])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash") // hashed at rest (ADR-009)
  familyId     String    @map("family_id") // reuse detection revokes the family (EDGE-A-02)
  deviceLabel  String?   @map("device_label")
  ip           String?
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model ActivationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") // hashed single-use (RULE-EMP-01)
  purpose   String // 'activation' | 'password_reset'
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("activation_tokens")
}

model LoginActivity {
  id             String       @id @default(uuid())
  userId         String?      @map("user_id") // null when the email did not resolve
  emailAttempted String       @map("email_attempted")
  outcome        LoginOutcome
  ip             String?
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
  @@map("login_activities")
}

// ================= COMPANY, CONTACT, CUSTOMER =================

model Company {
  id             String    @id @default(uuid())
  name           String
  normalizedName String    @map("normalized_name") // lower/trimmed — duplicate detection (EDGE-LD-01)
  country        String?
  city           String?
  address        String?
  website        String?
  industry       String?
  contacts       Contact[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([normalizedName])
  @@map("companies")
}

model Contact {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  phone     String?
  position  String?
  isPrimary Boolean  @default(false) @map("is_primary") // partial unique index — INV-05, DATABASE.md §5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("contacts")
}

model Customer {
  id                  String     @id @default(uuid())
  referenceNo         String     @unique @map("reference_no") // CST-YYYY-NNNNN (INV-12)
  companyId           String     @unique @map("company_id") // 1:1 (INV-06)
  source              LeadSource // carried from the lead (ADR-042)
  assignedBdoId       String?    @map("assigned_bdo_id") // users.id
  creditLimit         Decimal?   @map("credit_limit") @db.Decimal(14, 2)
  creditTermsDays     Int?       @map("credit_terms_days")
  convertedFromLeadId String?    @unique @map("converted_from_lead_id")
  isActive            Boolean    @default(true) @map("is_active")
  users               User[] // portal users (back-relation for users.customer_id)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([assignedBdoId])
  @@map("customers")
}

// ================= LEADS, OUTREACH, VISIT PLANS =================

model Lead {
  id                    String              @id @default(uuid())
  referenceNo           String              @unique @map("reference_no") // LED-YYYY-NNNNN
  companyId             String              @map("company_id") // created once, at lead time (RULE-LD-01)
  contactId             String              @map("contact_id")
  source                LeadSource // immutable (INV-13)
  status                LeadStatus          @default(new)
  ownerId               String              @map("owner_id") // owning BDO — users.id
  lostReason            String?             @map("lost_reason") // mandatory when lost (RULE-LD-06)
  convertedAt           DateTime?           @map("converted_at")
  convertedToCustomerId String?             @unique @map("converted_to_customer_id")
  createdById           String              @map("created_by_id")
  statusHistory         LeadStatusHistory[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([ownerId, status])
  @@index([companyId])
  @@map("leads")
}

model LeadStatusHistory {
  id         String      @id @default(uuid())
  leadId     String      @map("lead_id")
  lead       Lead        @relation(fields: [leadId], references: [id])
  fromStatus LeadStatus? @map("from_status")
  toStatus   LeadStatus  @map("to_status")
  actorId    String      @map("actor_id")
  notes      String?
  createdAt  DateTime    @default(now())

  @@index([leadId, createdAt])
  @@map("lead_status_history")
}

model Outreach {
  id          String          @id @default(uuid())
  leadId      String?         @map("lead_id") // exactly one target set — CHECK, DATABASE.md §5
  customerId  String?         @map("customer_id")
  type        OutreachType
  outcome     OutreachOutcome
  notes       String?
  durationMin Int?            @map("duration_min")
  followUpAt  DateTime?       @map("follow_up_at") // follow-ups-due dashboard
  visitPlanId String?         @unique @map("visit_plan_id") // set when created by a completed visit (RULE-VP-02)
  actorId     String          @map("actor_id")
  occurredAt  DateTime        @map("occurred_at")
  createdAt   DateTime        @default(now())

  @@index([leadId])
  @@index([customerId])
  @@index([actorId, followUpAt])
  @@map("outreach")
}

model VisitPlan {
  id                String          @id @default(uuid()) // ADR-043
  leadId            String?         @map("lead_id") // exactly one target set — CHECK, DATABASE.md §5
  customerId        String?         @map("customer_id")
  assignedToId      String          @map("assigned_to_id") // BDO/ASM — users.id
  purpose           String
  plannedAt         DateTime        @map("planned_at")
  location          String
  status            VisitPlanStatus @default(planned)
  outcome           String? // required on completed (RULE-VP-02)
  outcomeNotes      String?         @map("outcome_notes")
  cancelReason      String?         @map("cancel_reason")
  rescheduledFromId String?         @map("rescheduled_from_id") // prior plan on reschedule
  createdById       String          @map("created_by_id")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([assignedToId, status, plannedAt]) // upcoming-visits calendar
  @@index([leadId])
  @@index([customerId])
  @@map("visit_plans")
}

// ================= QUERY → QUOTATION =================

// A query is a plain enquiry: who is asking, where the goods move from and to, and
// which services they want. Everything operational (ports, packages, CRO/LC handling,
// cargo details) was removed — the quotation and shipment carry that now.
model Query {
  id                 String      @id @default(uuid())
  referenceNo        String      @unique @map("reference_no") // QRY-YYYY-NNNNN
  customerId         String      @map("customer_id")
  raisedById         String      @map("raised_by_id") // BDO or portal user — drives BDO/ASM scoping
  raisedVia          RaisedVia   @map("raised_via")
  status             QueryStatus @default(open)
  // Contact snapshot. Prefilled from the linked Customer but editable, so a BDO can
  // record the person who actually called without mutating the customer record.
  customerName       String      @map("customer_name")
  customerEmail      String      @map("customer_email")
  customerPhone      String      @map("customer_phone")
  pickupAddress      String      @map("pickup_address")
  destinationAddress String      @map("destination_address")
  services           String[] // free text since the package catalog was removed
  cancelReason       String?     @map("cancel_reason") // unserved-demand report (RULE-QRY-03)
  quotations         Quotation[]
  vendorRfqs         VendorRfq[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([customerId, status])
  @@index([status, createdAt]) // staleness sweep (RULE-QRY-04)
  @@map("queries")
}

model Quotation {
  id                String                @id @default(uuid())
  referenceNo       String                @unique @map("reference_no") // QT-YYYY-NNNNN
  queryId           String                @map("query_id")
  query             Query                 @relation(fields: [queryId], references: [id])
  version           Int                   @default(1) // revision = new row (ADR-019)
  parentQuotationId String?               @map("parent_quotation_id")
  status            QuotationStatus       @default(draft) // partial uniques INV-07/08, DATABASE.md §5
  services          String[] // snapshot from the query
  currency          String                @default("PKR") @db.Char(3)
  fxRate            Decimal?              @map("fx_rate") @db.Decimal(12, 6)
  totalAmount       Decimal               @default(0) @map("total_amount") @db.Decimal(14, 2) // server-computed (RULE-QT-02)
  validityDate      DateTime?             @map("validity_date") // auto-expiry (RULE-QT-06)
  createdById       String                @map("created_by_id") // ops_exec / ops_manager
  sentById          String?               @map("sent_by_id") // ops_manager only (RULE-QT-01)
  sentAt            DateTime?             @map("sent_at")
  decidedById       String?               @map("decided_by_id") // never the owning BDO (RULE-QT-03)
  decidedAt         DateTime?             @map("decided_at")
  approvalChannel   ApprovalChannel?      @map("approval_channel")
  // BDO → customer relay: after Ops sends, the BDO gives the quote to the customer
  // over mail/phone/WhatsApp and records how. Informational, never a gate.
  sharedVia         QuoteShareChannel?    @map("shared_via")
  sharedById        String?               @map("shared_by_id")
  sharedAt          DateTime?             @map("shared_at")
  shareNote         String?               @map("share_note")
  rejectionReason   String?               @map("rejection_reason") // required on reject (RULE-QT-04)
  rowVersion        Int                   @default(1) @map("row_version") // If-Match (RULE-QT-08)
  chargeLines       QuotationChargeLine[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([queryId, status])
  @@index([status, validityDate]) // nightly expiry job
  @@map("quotations")
}

model QuotationChargeLine {
  id           String       @id @default(uuid())
  quotationId  String       @map("quotation_id")
  quotation    Quotation    @relation(fields: [quotationId], references: [id])
  service      ServiceCode? // which service this charge belongs to
  chargeCode   String?      @map("charge_code") // ChargeType.code — drives charge seeding + step mapping
  description  String
  quantity     Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice    Decimal      @map("unit_price") @db.Decimal(14, 2)
  amount       Decimal      @db.Decimal(14, 2) // computed server-side (sell side)
  costAmount   Decimal?     @map("cost_amount") @db.Decimal(14, 2) // buy side — internal only
  costVendorId String?      @map("cost_vendor_id") // planned vendor hint (internal only)
  sortOrder    Int          @default(0) @map("sort_order")

  @@index([quotationId])
  @@map("quotation_charge_lines")
}

// ================= SHIPMENT, OTD, OTC, EXCEPTIONS =================

// DB form of WORKFLOW §4a.1 — seeded, read by the composition logic at approval time
model OtdStepTemplate {
  id               String         @id @default(uuid())
  canonicalNo      Int            @unique @map("canonical_no")
  stepCode         String         @unique @map("step_code")
  title            String
  ownerDepartment  DepartmentCode @map("owner_department") // ADR-003/039 ownership
  // There are no composition gates any more: every ACTIVE template composes onto every
  // shipment, in canonical order. A step that should no longer appear is deactivated,
  // never deleted, so historical shipments still resolve it by step code.
  // One plain-language line on what completing this step actually means — shown on the
  // step panel. Lives here (ADR-051) so admin-created steps carry their own guidance;
  // previously a hardcoded STEP_HINTS map in the frontend.
  hint             String?
  requiredDocTypes String[]       @map("required_doc_types") // RULE-SH-06
  dueOffsetHours   Int            @default(48) @map("due_offset_hours") // seeds the step's TaskTemplate SLA
  derivedStatus    ShipmentStatus @map("derived_status") // what completing this step derives
  // Superseded steps are kept, not deleted: composition skips them, but
  // missingRequiredDocs/recomputeStatus still resolve them BY STEP CODE for shipments
  // composed while they were live (ADR-048).
  active           Boolean        @default(true)
  actions          OtdStepActionTemplate[]

  @@map("otd_step_templates")
}

/**
 * The sub-action catalog (ADR-048) — the checklist that hangs under one main step.
 *
 * Gated exactly like the step catalog (package → CRO mode → service, each
 * empty-means-don't-gate), so one `order_confirmed` step can carry the seven-document
 * international pack and the shorter loading-point-to-port pack without becoming two
 * steps. This table is the SINGLE source of the step→sub-action mapping (ADR-001).
 */
model OtdStepActionTemplate {
  id         String           @id @default(uuid())
  stepCode   String           @map("step_code")
  step       OtdStepTemplate  @relation(fields: [stepCode], references: [stepCode], onDelete: Cascade)
  actionCode String           @map("action_code") // unique within the step
  title      String
  kind       StepActionKind   @default(manual)
  docType    String?          @map("doc_type") // required when kind = document
  sortOrder  Int              @map("sort_order")
  required   Boolean          @default(true) // false = advisory; does not gate completion

  @@unique([stepCode, actionCode])
  @@index([stepCode])
  @@map("otd_step_action_templates")
}

/**
 * A sub-action instance on one shipment's step. Rows exist ONLY for the sub-actions
 * the composition selected, mirroring INV-04 for steps.
 *
 * `status` is meaningful for `manual` actions only. A `document` action's satisfaction
 * is derived from the shipment's documents at read time and folded into the RULE-SH-06
 * gate — it is never written here, so it can never drift from the files on record.
 */
model OtdStepAction {
  id            String         @id @default(uuid())
  otdStepId     String         @map("otd_step_id")
  otdStep       OtdStep        @relation(fields: [otdStepId], references: [id], onDelete: Cascade)
  actionCode    String         @map("action_code")
  title         String
  kind          StepActionKind @default(manual)
  docType       String?        @map("doc_type")
  sortOrder     Int            @map("sort_order")
  required      Boolean        @default(true)
  status        OtdStepStatus  @default(pending) // `manual` only — see note above
  completedById String?        @map("completed_by_id")
  completedAt   DateTime?      @map("completed_at")
  notes         String?

  @@unique([otdStepId, actionCode])
  @@index([otdStepId])
  @@map("otd_step_actions")
}

model Shipment {
  id               String                  @id @default(uuid())
  referenceNo      String                  @unique @map("reference_no") // SHIP-YYYY-NNNNN
  // NULLABLE since trade shipments (roadmap Step 1): a `forwarding` shipment still
  // carries exactly one approved quote (INV-03), a `trade` shipment originates from a
  // Trade Contract instead. `@unique` still holds — Postgres allows repeated NULLs.
  // The kind ↔ origin pairing is enforced by shipments_origin_valid in sql/constraints.sql.
  quotationId      String?                 @unique @map("quotation_id") // INV-03 — exactly one approved quote (forwarding only)
  queryId          String?                 @unique @map("query_id")
  customerId       String                  @map("customer_id")
  kind             ShipmentKind            @default(forwarding)
  direction        ShipmentDirection?      // export | import — set on trade shipments
  // A trade shipment originates HERE instead of from a quotation (roadmap Step 1).
  contractId       String?                 @map("contract_id")
  contract         TradeContract?          @relation(fields: [contractId], references: [id])
  financialInstrumentId String?            @map("financial_instrument_id")
  financialInstrument FinancialInstrument? @relation(fields: [financialInstrumentId], references: [id])
  // Roadmap §7.1 — DERIVED from which trade documents exist, exactly as `status` is
  // derived from completed steps (ADR-014). Never written by an endpoint.
  tradeStage       TradeStage              @default(none) @map("trade_stage")
  services         String[] // FROZEN at approval (INV-14)
  status           ShipmentStatus          @default(booking) // DERIVED (ADR-014, INV-02)
  exceptionState   ExceptionState          @default(none) @map("exception_state") // orthogonal (RULE-SH-08)
  totalHoldMinutes Int                     @default(0) @map("total_hold_minutes")
  etd              DateTime?
  eta              DateTime? // ETA-breach sweep
  originPort       String?                 @map("origin_port")
  destinationPort  String?                 @map("destination_port")
  // Free-text door addresses, snapshotted from the Query at approval so transport knows
  // where to drive. `deliveryAddress` is fed by the query's `destinationAddress`.
  pickupAddress    String?                 @map("pickup_address")
  deliveryAddress  String?                 @map("delivery_address")
  // Shipper/consignee contacts + inland mode. The Query no longer carries these, so they
  // start null and are filled in by the shipment/trade module once the parties are known.
  senderName       String?                 @map("sender_name")
  senderPhone      String?                 @map("sender_phone")
  senderAddress    String?                 @map("sender_address")
  receiverName     String?                 @map("receiver_name")
  receiverPhone    String?                 @map("receiver_phone")
  receiverAddress  String?                 @map("receiver_address")
  inlandMode       InlandMode              @default(truck) @map("inland_mode")
  originRailTerminal      String?          @map("origin_rail_terminal")
  destinationRailTerminal String?          @map("destination_rail_terminal")
  // Import detention terms — the detention-free window the line grants the consignee, and
  // where the empty goes back. Set by the shipment/trade module, not inherited any more.
  freeDays         Int?                    @map("free_days")
  emptyReturnLocation String?              @map("empty_return_location")
  incoterm         String?
  cancelReason     String?                 @map("cancel_reason") // RULE-SH-11
  closedById       String?                 @map("closed_by_id") // ops_manager / Management (RULE-SH-12)
  closedAt         DateTime?               @map("closed_at")
  rowVersion       Int                     @default(1) @map("row_version")
  // ── Phase 2/3 — present now, null until then (CRM_MASTER §2/§10) ──
  vehicleId        String?                 @map("vehicle_id") // TMS
  gpsDeviceId      String?                 @map("gps_device_id") // telematics
  loadBoardRef     String?                 @map("load_board_ref") // load board
  lcNumber         String?                 @map("lc_number") // bank/LC handshake
  bankRef          String?                 @map("bank_ref")
  escrowRef        String?                 @map("escrow_ref")
  otdSteps         OtdStep[]
  otcMilestones    OtcMilestone[]
  exceptions       ShipmentException[]
  statusHistory    ShipmentStatusHistory[]
  parties          ShipmentParty[]
  containers       ShipmentContainer[]
  packingList      PackingList?
  tradeInvoices    TradeInvoice[]
  billOfLading     BillOfLading?
  goodsDeclaration GoodsDeclaration?
  tradeStageHistory ShipmentTradeStageHistory[]
  invoices         Invoice[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([customerId, status])
  @@index([status, exceptionState])
  @@index([eta])
  @@map("shipments")
}

model OtdStep {
  id              String         @id @default(uuid())
  shipmentId      String         @map("shipment_id")
  shipment        Shipment       @relation(fields: [shipmentId], references: [id])
  canonicalNo     Int            @map("canonical_no") // 1..14 — reporting key (RULE-SVC-05)
  displayNo       Int            @map("display_no") // 1..N of the composed path
  stepCode        String         @map("step_code")
  ownerDepartment DepartmentCode @map("owner_department") // completion guard (RULE-SH-04)
  status          OtdStepStatus  @default(pending)
  completedById   String?        @map("completed_by_id")
  completedAt     DateTime?      @map("completed_at")
  forced          Boolean        @default(false) // out-of-order override (RULE-SH-03)
  forceReason     String?        @map("force_reason")
  reopenCount     Int            @default(0) @map("reopen_count") // RULE-SH-05
  notes           String?        // free-text handover notes for the step owner
  formData        Json?          @map("form_data") // structured per-step capture (route/party/etc.)
  actions         OtdStepAction[] // the step's sub-action checklist (ADR-048)

  @@unique([shipmentId, canonicalNo]) // rows exist ONLY for the composed path (INV-04)
  @@unique([shipmentId, stepCode])
  @@index([shipmentId, status])
  @@map("otd_steps")
}

model ShipmentStatusHistory {
  id         String          @id @default(uuid())
  shipmentId String          @map("shipment_id")
  shipment   Shipment        @relation(fields: [shipmentId], references: [id])
  fromStatus ShipmentStatus? @map("from_status")
  toStatus   ShipmentStatus  @map("to_status")
  actorId    String?         @map("actor_id") // null for system recompute
  createdAt  DateTime        @default(now())

  @@index([shipmentId, createdAt])
  @@map("shipment_status_history")
}

model ShipmentException {
  id              String        @id @default(uuid())
  shipmentId      String        @map("shipment_id")
  shipment        Shipment      @relation(fields: [shipmentId], references: [id])
  type            ExceptionType
  reason          String
  raisedById      String        @map("raised_by_id")
  raisedAt        DateTime      @default(now()) @map("raised_at")
  resolvedById    String?       @map("resolved_by_id")
  resolvedAt      DateTime?     @map("resolved_at")
  resolutionNotes String?       @map("resolution_notes")
  holdMinutes     Int?          @map("hold_minutes") // elapsed, computed on resume (RULE-SH-10)

  @@index([shipmentId])
  @@map("shipment_exceptions")
}

// Who plays which role on THIS shipment (roadmap §2/§3/§7). The roadmap's central
// modelling rule: a party's contact and banking details are stored once on the party
// record, while the ROLE is captured per shipment — the same company can be a Vendor on
// one job and the Freight Forwarder on the next, and Consort itself is Manufacturer on
// an export and Freight Forwarder on an import.
//
// `vendors` is the party directory (it already carries NTN/STRN/REX/VAT/IBAN/SWIFT and
// bank branch); a CRM `Customer` may also hold a role without being duplicated into it.
// Exactly one of vendorId / customerId is set — shipment_parties_one_target in
// prisma/sql/constraints.sql.
model ShipmentParty {
  id         String    @id @default(uuid())
  shipmentId String    @map("shipment_id")
  shipment   Shipment  @relation(fields: [shipmentId], references: [id])
  role       PartyRole
  vendorId   String?   @map("vendor_id")
  vendor     Vendor?   @relation(fields: [vendorId], references: [id])
  customerId String?   @map("customer_id")
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // One company cannot hold the same role twice on one shipment. Two DIFFERENT
  // companies in the same role is legal and deliberate — the roadmap's Ahmad Saeed
  // B/L carries two notify parties (Consort and Javed Latif).
  @@unique([shipmentId, role, vendorId])
  @@unique([shipmentId, role, customerId])
  @@index([shipmentId])
  @@index([vendorId])
  @@map("shipment_parties")
}

model OtcMilestone {
  id            String             @id @default(uuid())
  shipmentId    String             @map("shipment_id")
  shipment      Shipment           @relation(fields: [shipmentId], references: [id])
  milestoneNo   Int                @map("milestone_no") // 1..5, seeded at approval (RULE-QT-07)
  type          OtcMilestoneType
  status        OtcMilestoneStatus @default(pending)
  amount        Decimal?           @db.Decimal(14, 2) // display mirror only (ADR-006)
  completedById String?            @map("completed_by_id") // null when auto (RULE-FI-02/03)
  completedAt   DateTime?          @map("completed_at")

  @@unique([shipmentId, milestoneNo])
  @@map("otc_milestones")
}

// ================= FINANCE =================

enum InvoiceKind {
  receivable // money IN — the customer owes us (auto-drafted from the quotation)
  payable // money OUT — we owe a vendor/carrier (recorded against a step)
}

model Invoice {
  id          String        @id @default(uuid())
  referenceNo String        @unique @map("reference_no") // INV-YYYY-NNNNN
  shipmentId  String        @map("shipment_id")
  shipment    Shipment      @relation(fields: [shipmentId], references: [id])
  kind        InvoiceKind   @default(receivable) // receivable ledger drives OTC/settlement; payable is separate
  quotationId String?       @map("quotation_id") // set for the auto-drafted receivable (RULE-FI-01); null for manual invoices
  otdStepId   String?       @map("otd_step_id") // the step this invoice was raised from (optional)
  vendorId    String?       @map("vendor_id") // payables — the vendor being billed; null for the customer receivable
  vendor      Vendor?       @relation(fields: [vendorId], references: [id])
  counterparty String?      @map("counterparty") // legacy/display fallback vendor name (payables)
  // Roadmap §6 — a terminal or forwarder bill quotes the B/L, the container and the
  // FI. Foreign keys rather than numbers re-typed into the description.
  billOfLadingId String?    @map("bill_of_lading_id")
  billOfLading BillOfLading? @relation(fields: [billOfLadingId], references: [id])
  goodsDeclarationId String? @map("goods_declaration_id")
  goodsDeclaration GoodsDeclaration? @relation(fields: [goodsDeclarationId], references: [id])
  financialInstrumentId String? @map("financial_instrument_id")
  financialInstrument FinancialInstrument? @relation(fields: [financialInstrumentId], references: [id])
  containerId String?      @map("container_id")
  container   ShipmentContainer? @relation(fields: [containerId], references: [id])
  status      InvoiceStatus @default(draft)
  currency    String        @db.Char(3)
  fxRate      Decimal?      @map("fx_rate") @db.Decimal(12, 6) // captured at commit (ADR-006)
  totalAmount Decimal       @map("total_amount") @db.Decimal(14, 2)
  // Sum of the lines' tax (§4.7 — every QICT charge carries 15% Sindh Sales Tax).
  taxTotal    Decimal?      @map("tax_total") @db.Decimal(14, 2)
  issuedById  String?       @map("issued_by_id") // accounts
  issuedAt    DateTime?     @map("issued_at")
  dueDate     DateTime?     @map("due_date") // overdue sweep
  voidedById  String?       @map("voided_by_id") // only while unpaid (RULE-FI-05)
  voidedAt    DateTime?     @map("voided_at")
  voidReason  String?       @map("void_reason")
  lines       InvoiceLine[]
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([shipmentId])
  @@index([status, dueDate])
  @@index([vendorId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)
  // §4.7 — the terminal bill is an itemised list of named charges, each taxed.
  chargeCode  String? @map("charge_code") // charge_types.code
  taxPercent  Decimal? @map("tax_percent") @db.Decimal(5, 2)
  taxAmount   Decimal? @map("tax_amount") @db.Decimal(14, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String        @map("invoice_id")
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  amount          Decimal       @db.Decimal(14, 2)
  method          PaymentMethod
  referenceNumber String?       @map("reference_number") // bank ref / cheque no
  fxRate          Decimal?      @map("fx_rate") @db.Decimal(12, 6)
  receivedAt      DateTime      @map("received_at")
  recordedById    String        @map("recorded_by_id")
  createdAt       DateTime      @default(now())

  @@index([invoiceId])
  @@map("payments")
}

// ================= VENDORS & JOB-CHARGE LEDGER =================

model Vendor {
  id               String           @id @default(uuid())
  referenceNo      String           @unique @map("reference_no") // VEN-YYYY-NNNNN
  name             String
  normalizedName   String           @map("normalized_name") // duplicate detection
  type             VendorType
  contactName      String?          @map("contact_name")
  email            String?
  phone            String?
  address          String?
  country          String?
  city             String?
  taxId            String?          @map("tax_id") // NTN / STRN
  paymentTermsDays Int?             @map("payment_terms_days")
  currency         String?          @db.Char(3)
  strn             String?          @map("strn") // Sindh Sales Tax Registration No.
  rexNo            String?          @map("rex_no") // REX Registration No. (exporters)
  vatNo            String?          @map("vat_no") // VAT/TVA No. (foreign buyers)
  bankName         String?          @map("bank_name")
  bankBranch       String?          @map("bank_branch")
  iban             String?          @map("iban")
  swiftCode        String?          @map("swift_code") @db.VarChar(11)
  accountTitle     String?          @map("account_title")
  website          String?          @map("website")
  notes            String?
  isActive         Boolean          @default(true) @map("is_active")
  invoices         Invoice[]
  vendorQuotes     VendorQuote[]
  shipmentParties  ShipmentParty[]
  // Trade-document back-relations. Each is a NAMED relation because several trade
  // documents point at `vendors` more than once (an FI names the vendor, its bank and
  // the buyer). Real FKs, not loose ids — they are also what stops a vendor being hard
  // deleted out from under a Bill of Lading.
  tradeContracts       TradeContract[]       @relation("TradeContractVendor")
  fiAsVendor           FinancialInstrument[] @relation("FiVendor")
  fiAsBank             FinancialInstrument[] @relation("FiBank")
  fiAsBuyer            FinancialInstrument[] @relation("FiBuyer")
  packingListsIssued   PackingList[]         @relation("PackingListIssuer")
  tradeInvoicesSold    TradeInvoice[]        @relation("TradeInvoiceSeller")
  tradeInvoicesBought  TradeInvoice[]        @relation("TradeInvoiceBuyer")
  tradeInvoicesBanked  TradeInvoice[]        @relation("TradeInvoiceBank")
  bolAsCarrier         BillOfLading[]        @relation("BolCarrier")
  bolAsCarrierAgent    BillOfLading[]        @relation("BolCarrierAgent")
  gdAsClearingAgent    GoodsDeclaration[]    @relation("GdClearingAgent")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([normalizedName])
  @@index([type, isActive])
  @@map("vendors")
}

// ================= VENDOR RFQ (BUY SIDE) =================

// The buy side of a query. Ops asks N vendors of the matching type for a price
// on one service, types their replies in (vendors answer by phone/WhatsApp —
// there is no vendor portal), picks a winner, and the winning lines seed the
// cost sheet of the customer quotation.
//
// At most ONE open RFQ per (query, service) — enforced by a partial unique index
// in prisma/sql/constraints.sql, so a cancelled RFQ can still be re-issued.
model VendorRfq {
  id          String        @id @default(uuid())
  referenceNo String        @unique @map("reference_no") // RFQ-YYYY-NNNNN
  queryId     String        @map("query_id")
  query       Query         @relation(fields: [queryId], references: [id])
  service     ServiceCode // one RFQ per sold service; lc_finance is never RFQ'd
  // Rail inland only: the transport service is asked per leg, each with its own
  // vendors and its own winner. Null = the whole service (truck, or non-transport).
  leg         RfqLeg?
  status      RfqStatus     @default(open)
  neededBy    DateTime?     @map("needed_by")
  notes       String?
  createdById String        @map("created_by_id")
  quotes      VendorQuote[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([queryId, status])
  @@index([status, createdAt]) // board view
  @@map("vendor_rfqs")
}

// One vendor's response to an RFQ. Created `pending` the moment the vendor is
// asked, so the board shows who owes an answer. `totalAmount` is server-computed
// from the lines, never trusted from the client (mirrors RULE-QT-02).
model VendorQuote {
  id           String            @id @default(uuid())
  rfqId        String            @map("rfq_id")
  rfq          VendorRfq         @relation(fields: [rfqId], references: [id])
  vendorId     String            @map("vendor_id")
  vendor       Vendor            @relation(fields: [vendorId], references: [id])
  status       VendorQuoteStatus @default(pending)
  currency     String            @default("PKR") @db.Char(3)
  validityDate DateTime?         @map("validity_date")
  notes        String?
  totalAmount  Decimal           @default(0) @map("total_amount") @db.Decimal(14, 2)
  receivedAt   DateTime?         @map("received_at")
  enteredById  String?           @map("entered_by_id") // ops person who typed it in
  // The winner. At most one selected per RFQ — partial unique in constraints.sql.
  isSelected   Boolean           @default(false) @map("is_selected")
  awardedAt    DateTime?         @map("awarded_at")
  awardedById  String?           @map("awarded_by_id")
  lines        VendorQuoteLine[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([rfqId, vendorId])
  @@index([vendorId])
  @@map("vendor_quotes")
}

model VendorQuoteLine {
  id          String      @id @default(uuid())
  quoteId     String      @map("quote_id")
  quote       VendorQuote @relation(fields: [quoteId], references: [id])
  chargeCode  String?     @map("charge_code") // → ChargeType.code
  description String
  quantity    Decimal     @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal     @map("unit_price") @db.Decimal(14, 2)
  amount      Decimal     @db.Decimal(14, 2) // server-computed
  sortOrder   Int         @default(0) @map("sort_order")

  @@index([quoteId])
  @@map("vendor_quote_lines")
}

// ================= OWN FLEET =================

// Drivers and vehicles are OWN operational master data, not counterparties — a
// driver is never billed, so they are deliberately not Vendors. Both carry
// documents (CNIC, licence, registration) through the polymorphic Document
// table, which is the whole reason they are first-class rows.

model Driver {
  id          String   @id @default(uuid())
  referenceNo String   @unique @map("reference_no") // DRV-YYYY-NNNNN
  name        String
  phone       String?
  cnic        String? // 13-digit national ID, stored digits-only
  licenseNo   String?  @map("license_no")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("drivers")
}

model FleetVehicle {
  id          String      @id @default(uuid())
  referenceNo String      @unique @map("reference_no") // VEH-YYYY-NNNNN
  kind        VehicleKind
  plateNo     String      @map("plate_no") // registration number
  notes       String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([kind, isActive])
  @@map("fleet_vehicles")
}

// Seeded, admin-extensible charge catalog (a table, not an enum). This is quote
// pricing vocabulary — QuotationChargeLine.chargeCode names one of these codes so
// the quote builder can categorise what it is selling. There is no shipment-side
// charge ledger: on a job, invoices are the money record.
model ChargeType {
  code             String           @id // 'ocean_freight', 'lolo', ...
  label            String
  defaultDirection ChargeDirection? @map("default_direction")
  defaultStepCode  String?          @map("default_step_code") // where this money usually lands
  service          ServiceCode? // which sold service it belongs to
  isActive         Boolean          @default(true) @map("is_active")

  @@map("charge_types")
}

// ================= ACTION ENGINE & TASKS =================

model TaskTemplate {
  id               String         @id @default(uuid())
  eventCode        String         @map("event_code") // from the closed catalog (ADR-020)
  stepCode         String?        @map("step_code") // fires only if on the composed path (RULE-AE-07)
  title            String
  description      String?
  department       DepartmentCode
  dueOffsetHours   Int            @map("due_offset_hours")
  requiredDocTypes String[]       @map("required_doc_types")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([eventCode, isActive])
  @@map("task_templates")
}

model Task {
  id               String      @id @default(uuid())
  idempotencyKey   String      @unique @map("idempotency_key") // replay-safe upsert (RULE-AE-04)
  origin           TaskOrigin
  templateId       String?     @map("template_id")
  shipmentId       String?     @map("shipment_id")
  queryId          String?     @map("query_id") // compliance pre-check (RULE-QRY-02)
  otdStepId        String?     @map("otd_step_id") // submitting completes the step (RULE-TK-02)
  title            String
  description      String?
  departmentId     String      @map("department_id") // RULE-TK-01
  assigneeId       String?     @map("assignee_id") // null = department queue (RULE-AE-03)
  status           TaskStatus  @default(open)
  statusBeforeHold TaskStatus? @map("status_before_hold") // ADR-038 — held iff sla_paused_at set
  slaPausedAt      DateTime?   @map("sla_paused_at")
  dueDate          DateTime?   @map("due_date") // shifted by hold_minutes on resume (RULE-SH-10)
  completedById    String?     @map("completed_by_id")
  completedAt      DateTime?   @map("completed_at")
  cancelReason     String?     @map("cancel_reason")
  rowVersion       Int         @default(1) @map("row_version")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([assigneeId, status])
  @@index([departmentId, status]) // department queue
  @@index([shipmentId])
  @@index([status, dueDate]) // overdue sweep
  @@map("tasks")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String    @map("event_type") // closed catalog (ADR-020)
  payload       Json
  correlationId String    @map("correlation_id")
  dispatchedAt  DateTime? @map("dispatched_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now())

  @@index([dispatchedAt, createdAt]) // relay poll (ADR-021)
  @@map("outbox_events")
}

// ================= DOCUMENTS =================

// Admin-managed document vocabulary (ADR-051) — the closed DOC_TYPES list that lived in
// modules/document/document.validation.js (and its frontend mirror) as data. Uploads
// validate against ACTIVE rows; `customerUploadable` replaces the hardcoded
// CUSTOMER_UPLOADABLE_DOC_TYPES allowlist. Rows referenced by documents or templates are
// deactivated, never deleted, so historical docTypes always resolve to a label.
model DocumentType {
  code               String  @id // ^[a-z][a-z0-9_]{1,49}$ — same format guard as step codes
  label              String
  customerUploadable Boolean @default(false) @map("customer_uploadable")
  active             Boolean @default(true)
  sortOrder          Int     @default(0) @map("sort_order")

  @@map("document_types")
}

model Document {
  id            String            @id @default(uuid())
  ownerType     DocumentOwnerType @map("owner_type") // polymorphic (RULE-DOC-03)
  ownerId       String            @map("owner_id")
  otdStepId     String?           @map("otd_step_id") // groups a doc/proof under a specific shipment step
  fileName      String            @map("file_name")
  mimeType      String            @map("mime_type")
  sizeBytes     Int               @map("size_bytes")
  checksum      String // dedup (RULE-DOC-02)
  storageKey    String            @unique @map("storage_key")
  docType       String?           @map("doc_type") // 'gd' | 'bol' | 'pod' | … (RULE-SH-06)
  isPublished   Boolean           @default(false) @map("is_published") // INV-10 — internal by default
  publishedById String?           @map("published_by_id")
  publishedAt   DateTime?         @map("published_at")
  scanStatus    ScanStatus        @default(pending) @map("scan_status")
  uploadedById  String            @map("uploaded_by_id")
  deletedAt     DateTime?         @map("deleted_at") // soft delete (RULE-DOC-04)
  createdAt     DateTime          @default(now())

  @@index([ownerType, ownerId])
  @@index([checksum])
  @@map("documents")
}

// ================= CHAT =================

model ChatChannel {
  id           String              @id @default(uuid())
  type         ChannelType
  name         String?
  shipmentId   String?             @unique @map("shipment_id") // auto-created at shipment birth (RULE-QT-07)
  departmentId String?             @map("department_id")
  members      ChatChannelMember[]
  messages     ChatMessage[]
  createdAt    DateTime            @default(now())

  @@map("chat_channels")
}

model ChatChannelMember {
  id                String      @id @default(uuid())
  channelId         String      @map("channel_id")
  channel           ChatChannel @relation(fields: [channelId], references: [id])
  userId            String      @map("user_id") // customers never members (INV-11) — app guard
  joinedAt          DateTime    @default(now()) @map("joined_at")
  leftAt            DateTime?   @map("left_at") // set on offboarding (RULE-EMP-05)
  lastReadMessageId String?     @map("last_read_message_id") // unread counts

  @@unique([channelId, userId])
  @@index([userId])
  @@map("chat_channel_members")
}

model ChatMessage {
  id              String      @id @default(uuid())
  channelId       String      @map("channel_id")
  channel         ChatChannel @relation(fields: [channelId], references: [id])
  senderId        String      @map("sender_id")
  clientMessageId String      @map("client_message_id") // idempotent sends (RULE-CH-02)
  body            String
  replyToId       String?     @map("reply_to_id")
  editedAt        DateTime?   @map("edited_at")
  deletedAt       DateTime?   @map("deleted_at") // soft delete
  createdAt       DateTime    @default(now())

  @@unique([channelId, clientMessageId])
  @@index([channelId, createdAt])
  @@map("chat_messages")
}

// ================= NOTIFICATIONS =================

model Notification {
  id         String                 @id @default(uuid())
  userId     String                 @map("user_id")
  type       String // event code, e.g. 'task.assigned'
  title      String
  body       String?
  priority   Int                    @default(0)
  actionUrl  String?                @map("action_url")
  groupKey   String?                @map("group_key")
  readAt     DateTime?              @map("read_at")
  deliveries NotificationDelivery[]
  createdAt  DateTime               @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String              @id @default(uuid())
  notificationId String              @map("notification_id")
  notification   Notification        @relation(fields: [notificationId], references: [id])
  channel        NotificationChannel
  status         DeliveryStatus      @default(queued) // "I never received it" is answerable (RULE-NT-03)
  sentAt         DateTime?           @map("sent_at")
  error          String?

  @@index([notificationId])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id      String              @id @default(uuid())
  userId  String              @map("user_id")
  type    String // 'task.assigned' & 'shipment.held' cannot be disabled — app-enforced (RULE-NT-01)
  channel NotificationChannel
  enabled Boolean             @default(true)

  @@unique([userId, type, channel])
  @@map("notification_preferences")
}

// ================= AUDIT & REFERENCE DATA =================

model AuditLog {
  id            String   @id @default(uuid()) // written once, by the global interceptor (INV-15)
  actorId       String?  @map("actor_id") // null for system jobs
  action        String // 'shipment.step.complete', …
  resourceType  String   @map("resource_type")
  resourceId    String   @map("resource_id")
  diff          Json? // field-level before/after
  ip            String?
  correlationId String   @map("correlation_id")
  createdAt     DateTime @default(now())

  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model ReferenceSequence {
  id        String @id @default(uuid())
  entity    String // 'lead' | 'customer' | 'query' | 'quotation' | 'shipment' | 'invoice'
  year      Int
  lastValue Int    @default(0) @map("last_value") // allocated inside the owning transaction

  @@unique([entity, year])
  @@map("reference_sequences")
}

model Port {
  code    String @id // UN/LOCODE
  name    String
  country String

  @@map("ports")
}

model ContainerType {
  code  String @id // '20GP', '40HC', 'REEFER20', …
  label String

  @@map("container_types")
}

// ================= INTAKE CHANNELS & PUBLIC STOREFRONT =================
// CRM_MASTER §5.20/§5.21, WORKFLOW §2b/§2c/§8a/§8b.

// Indicative pricing for the public rate calculator (§5.20). The calculator
// picks the most specific active card per service (exact lane+container >
// lane > service-only) and sums; a hard-coded fallback guarantees a result
// even before any card is seeded. Non-binding — the quotation is authoritative.
model RateCard {
  id                String      @id @default(uuid())
  service           ServiceCode
  originPort        String?     @map("origin_port") // null = any lane
  destinationPort   String?     @map("destination_port")
  containerTypeCode String?     @map("container_type_code") // null = any container
  currency          String      @default("PKR") @db.Char(3)
  baseAmount        Decimal     @map("base_amount") @db.Decimal(14, 2)
  perKgAmount       Decimal?    @map("per_kg_amount") @db.Decimal(14, 4) // optional weight surcharge
  minAmount         Decimal?    @map("min_amount") @db.Decimal(14, 2)
  notes             String?
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([service, isActive])
  @@index([originPort, destinationPort])
  @@map("rate_cards")
}

// Publicly-browsable indicative available capacity/lanes (§5.20). Curated by
// Operations/Transport; the public sees only active `open` postings. This is
// a lead-gen shopfront — NOT the Phase-2 TMS carrier load-matching board (§10).
model LoadBoardPosting {
  id                String          @id @default(uuid())
  referenceNo       String          @unique @map("reference_no") // LB-YYYY-NNNNN
  mode              TransportMode
  originPort        String          @map("origin_port")
  destinationPort   String          @map("destination_port")
  containerTypeCode String?         @map("container_type_code")
  equipment         String? // "40HC x3", "Reefer", "Flatbed"
  capacity          Int? // available units
  departureDate     DateTime?       @map("departure_date")
  validUntil        DateTime?       @map("valid_until") // expiry sweep (WORKFLOW §14)
  transitDays       Int?            @map("transit_days")
  indicativeRate    Decimal?        @map("indicative_rate") @db.Decimal(14, 2)
  currency          String          @default("PKR") @db.Char(3)
  services          ServiceCode[] // what's on offer
  notes             String?
  status            LoadBoardStatus @default(open)
  isActive          Boolean         @default(true) @map("is_active")
  createdById       String?         @map("created_by_id") // internal poster (ops/transport)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, isActive])
  @@index([originPort, destinationPort])
  @@map("load_board_postings")
}

// Inbound bank LC posted to the intake webhook (§5.21, WORKFLOW §2c).
// Idempotent on the bank's own reference so replays never duplicate.
model BankLcReferral {
  id               String       @id @default(uuid())
  referenceNo      String       @unique @map("reference_no") // LC-YYYY-NNNNN (intake ref)
  idempotencyKey   String       @unique @map("idempotency_key") // dedupe bank replays
  lcNumber         String       @map("lc_number") // the bank's LC number
  bankName         String?      @map("bank_name")
  bankRef          String?      @map("bank_ref")
  applicantName    String?      @map("applicant_name") // buyer/importer
  applicantEmail   String?      @map("applicant_email")
  applicantPhone   String?      @map("applicant_phone")
  companyName      String?      @map("company_name")
  beneficiaryName  String?      @map("beneficiary_name")
  amount           Decimal?     @db.Decimal(14, 2)
  currency         String?      @db.Char(3)
  originPort       String?      @map("origin_port")
  destinationPort  String?      @map("destination_port")
  commodity        String?
  incoterm         String?
  issueDate        DateTime?    @map("issue_date")
  expiryDate       DateTime?    @map("expiry_date")
  rawPayload       Json         @map("raw_payload") // full webhook body, for audit
  status           BankLcStatus @default(received)
  reviewedById     String?      @map("reviewed_by_id")
  convertedCustomerId String?   @map("converted_customer_id")
  convertedLeadId  String?      @map("converted_lead_id")
  convertedQueryId String?      @map("converted_query_id")
  rejectReason     String?      @map("reject_reason")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, createdAt])
  @@map("bank_lc_referrals")
}

// ================= EXPORT TRADE DOCUMENTS =================
// Structured records for the paper trail in Export_Shipment_Workflow_CRM_Roadmap §4.
// Every document that used to exist only as an uploaded PDF tagged with a docType now
// also has its fields, and the values that flow downstream (§6) are foreign keys here
// rather than numbers re-typed onto the next form.

// §4.1 — Sales Contract / Proforma Invoice. Not a scanned file in the sample set, but
// every downstream document quotes its number and date, so it is the root record.
model TradeContract {
  id                   String                @id @default(uuid())
  referenceNo          String                @unique @map("reference_no") // TCN-YYYY-NNNNN
  contractNo           String                @map("contract_no") // e.g. AST/09/25/002
  contractDate         DateTime?             @map("contract_date")
  direction            ShipmentDirection     @default(export)
  vendorId             String                @map("vendor_id")
  vendor               Vendor                @relation("TradeContractVendor", fields: [vendorId], references: [id])
  customerId           String?               @map("customer_id") // customers.id — a plain id, as on shipments
  incoterm             String?
  currency             String                @db.Char(3)
  totalValue           Decimal?              @map("total_value") @db.Decimal(14, 2)
  paymentTerms         String?               @map("payment_terms")
  productDescription   String?               @map("product_description")
  notes                String?
  status               TradeContractStatus   @default(active)
  financialInstruments FinancialInstrument[]
  shipments            Shipment[]
  createdById          String?               @map("created_by_id")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([vendorId])
  @@index([customerId])
  @@map("trade_contracts")
}

// §4.2 — the bank EXP registration (BIP-EXP-296937-14112025 in the sample set), or an
// LC / documentary collection carrying the same shape. One vendor holds many of these
// against potentially different customers, and each shipment draws on exactly one.
model FinancialInstrument {
  id                    String                        @id @default(uuid())
  referenceNo           String                        @unique @map("reference_no") // FI-YYYY-NNNNN
  fiNumber              String                        @unique @map("fi_number") // the number the bank issued
  type                  FinancialInstrumentType       @default(exp_form)
  contractId            String?                       @map("contract_id")
  contract              TradeContract?                @relation(fields: [contractId], references: [id])
  vendorId              String                        @map("vendor_id")
  vendor                Vendor                        @relation("FiVendor", fields: [vendorId], references: [id])
  bankVendorId          String                        @map("bank_vendor_id")
  bank                  Vendor                        @relation("FiBank", fields: [bankVendorId], references: [id])
  customerId            String?                       @map("customer_id")
  buyerVendorId         String?                       @map("buyer_vendor_id")
  buyer                 Vendor?                       @relation("FiBuyer", fields: [buyerVendorId], references: [id])
  incoterm              String?
  currency              String                        @db.Char(3)
  value                 Decimal                       @db.Decimal(14, 2)
  // "60% CAD / 40% DA 75 days from B/L date" decomposed, so the DA maturity can be
  // computed off the Bill of Lading rather than read out of a sentence.
  cadPercent            Decimal?                      @map("cad_percent") @db.Decimal(5, 2)
  daPercent             Decimal?                      @map("da_percent") @db.Decimal(5, 2)
  daDays                Int?                          @map("da_days")
  paymentTermsText      String?                       @map("payment_terms_text")
  portOfDischarge       String?                       @map("port_of_discharge")
  issueDate             DateTime?                     @map("issue_date")
  expiryDate            DateTime                      @map("expiry_date")
  status                FinancialInstrumentStatus     @default(active)
  // Maintained ONLY by drawdown rows (ADR-001) — never hand-edited.
  drawnAmount           Decimal                       @default(0) @map("drawn_amount") @db.Decimal(14, 2)
  expiryNotifiedAt      DateTime?                     @map("expiry_notified_at") // de-dupes the nightly sweep
  closedById            String?                       @map("closed_by_id")
  closedAt              DateTime?                     @map("closed_at")
  notes                 String?
  drawdowns             FinancialInstrumentDrawdown[]
  shipments             Shipment[]
  tradeInvoices         TradeInvoice[]
  goodsDeclarations     GoodsDeclaration[]
  logisticsInvoices     Invoice[]
  createdById           String?                       @map("created_by_id")
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@index([status, expiryDate])
  @@index([vendorId])
  @@map("financial_instruments")
}

// Realisation of export proceeds against the instrument (roadmap Step 7). The sum of
// these is what `drawnAmount` mirrors, and what lets Step 8 close the instrument.
model FinancialInstrumentDrawdown {
  id                    String              @id @default(uuid())
  financialInstrumentId String              @map("financial_instrument_id")
  financialInstrument   FinancialInstrument @relation(fields: [financialInstrumentId], references: [id])
  shipmentId            String?             @map("shipment_id")
  paymentId             String?             @map("payment_id")
  tradeInvoiceId        String?             @map("trade_invoice_id")
  amount                Decimal             @db.Decimal(14, 2)
  realisedAt            DateTime            @map("realised_at")
  notes                 String?
  recordedById          String?             @map("recorded_by_id")
  createdAt             DateTime            @default(now())

  @@index([financialInstrumentId])
  @@index([shipmentId])
  @@map("financial_instrument_drawdowns")
}

// §7 "Shipment / Container". The EIR steps have always implied a container number and a
// seal; until now neither had anywhere to live.
model ShipmentContainer {
  id                String                  @id @default(uuid())
  shipmentId        String                  @map("shipment_id")
  shipment          Shipment                @relation(fields: [shipmentId], references: [id])
  containerNo       String                  @map("container_no")
  sealNo            String?                 @map("seal_no")
  containerTypeCode String?                 @map("container_type_code")
  cartons           Int?
  netWeightKg       Decimal?                @map("net_weight_kg") @db.Decimal(12, 3)
  grossWeightKg     Decimal?                @map("gross_weight_kg") @db.Decimal(12, 3)
  packingLists      PackingList[]
  bolContainers     BillOfLadingContainer[]
  logisticsInvoices Invoice[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([shipmentId, containerNo])
  @@index([shipmentId])
  @@map("shipment_containers")
}

// §4.3 — issued by the vendor factory. The authoritative source for carton, piece and
// weight data, which the Commercial Invoice, the B/L and the GD all restate (§6).
model PackingList {
  id                 String             @id @default(uuid())
  referenceNo        String             @unique @map("reference_no") // PL-YYYY-NNNNN
  shipmentId         String             @unique @map("shipment_id")
  shipment           Shipment           @relation(fields: [shipmentId], references: [id])
  containerId        String?            @map("container_id")
  container          ShipmentContainer? @relation(fields: [containerId], references: [id])
  issuedByVendorId   String?            @map("issued_by_vendor_id")
  issuedByVendor     Vendor?            @relation("PackingListIssuer", fields: [issuedByVendorId], references: [id])
  customerId         String?            @map("customer_id")
  listDate           DateTime?          @map("list_date")
  // Totals are RECOMPUTED from the items on every write, never accepted from a client.
  totalCartons       Int?               @map("total_cartons")
  totalPieces        Int?               @map("total_pieces")
  totalNetWeightKg   Decimal?           @map("total_net_weight_kg") @db.Decimal(12, 3)
  totalGrossWeightKg Decimal?           @map("total_gross_weight_kg") @db.Decimal(12, 3)
  notes              String?
  confirmedById      String?            @map("confirmed_by_id")
  confirmedAt        DateTime?          @map("confirmed_at")
  documentId         String?            @map("document_id") // the generated or scanned PDF
  items              PackingListItem[]
  tradeInvoices      TradeInvoice[]
  createdById        String?            @map("created_by_id")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("packing_lists")
}

model PackingListItem {
  id            String             @id @default(uuid())
  packingListId String             @map("packing_list_id")
  packingList   PackingList        @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  skuRef        String?            @map("sku_ref")
  description   String
  hsCode        String?            @map("hs_code")
  qtyPerBox     Int?               @map("qty_per_box")
  boxes         Int?
  pieces        Int?
  netWeightKg   Decimal?           @map("net_weight_kg") @db.Decimal(12, 3)
  grossWeightKg Decimal?           @map("gross_weight_kg") @db.Decimal(12, 3)
  sortOrder     Int                @default(0) @map("sort_order")
  invoiceLines  TradeInvoiceLine[]

  @@index([packingListId])
  @@map("packing_list_items")
}

// §4.4 — the goods invoice. `side` is what carries the merchant economics: `purchase`
// is the vendor billing Consort (a cost), `sale` is Consort billing the customer
// (revenue), and issuing a sale drafts the receivable the OTC ledger already runs on.
model TradeInvoice {
  id                    String               @id @default(uuid())
  referenceNo           String               @unique @map("reference_no") // TIN-YYYY-NNNNN
  shipmentId            String               @map("shipment_id")
  shipment              Shipment             @relation(fields: [shipmentId], references: [id])
  side                  TradeInvoiceSide
  invoiceNo             String               @map("invoice_no") // e.g. AST/11/25/003
  invoiceDate           DateTime             @map("invoice_date")
  financialInstrumentId String?              @map("financial_instrument_id")
  financialInstrument   FinancialInstrument? @relation(fields: [financialInstrumentId], references: [id])
  packingListId         String?              @map("packing_list_id")
  packingList           PackingList?         @relation(fields: [packingListId], references: [id])
  sellerVendorId        String?              @map("seller_vendor_id")
  sellerVendor          Vendor?              @relation("TradeInvoiceSeller", fields: [sellerVendorId], references: [id])
  buyerVendorId         String?              @map("buyer_vendor_id")
  buyerVendor           Vendor?              @relation("TradeInvoiceBuyer", fields: [buyerVendorId], references: [id])
  sellerCustomerId      String?              @map("seller_customer_id")
  buyerCustomerId       String?              @map("buyer_customer_id")
  bankVendorId          String?              @map("bank_vendor_id")
  bankVendor            Vendor?              @relation("TradeInvoiceBank", fields: [bankVendorId], references: [id])
  incoterm              String?
  shipmentTerms         String?              @map("shipment_terms") // e.g. CFR Antwerp
  rexNo                 String?              @map("rex_no")
  originStatement       String?              @map("origin_statement")
  currency              String               @db.Char(3)
  totalValue            Decimal              @default(0) @map("total_value") @db.Decimal(14, 2) // recomputed from lines
  status                TradeInvoiceStatus   @default(draft)
  issuedById            String?              @map("issued_by_id")
  issuedAt              DateTime?            @map("issued_at")
  voidedById            String?              @map("voided_by_id")
  voidedAt              DateTime?            @map("voided_at")
  voidReason            String?              @map("void_reason")
  receivableInvoiceId   String?              @map("receivable_invoice_id") // the AR invoice a sale drafted
  documentId            String?              @map("document_id")
  notes                 String?
  lines                 TradeInvoiceLine[]
  goodsDeclarations     GoodsDeclaration[]
  createdById           String?              @map("created_by_id")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([shipmentId, side, invoiceNo])
  @@index([shipmentId])
  @@index([financialInstrumentId])
  @@map("trade_invoices")
}

model TradeInvoiceLine {
  id                String                 @id @default(uuid())
  tradeInvoiceId    String                 @map("trade_invoice_id")
  tradeInvoice      TradeInvoice           @relation(fields: [tradeInvoiceId], references: [id], onDelete: Cascade)
  // Set when the line was seeded from the packing list, which is what keeps cartons,
  // pieces and HS codes from being re-typed (§6, §8).
  packingListItemId String?                @map("packing_list_item_id")
  packingListItem   PackingListItem?       @relation(fields: [packingListItemId], references: [id])
  description       String
  hsCode            String?                @map("hs_code")
  quantity          Decimal                @default(1) @db.Decimal(14, 3)
  unitOfMeasure     String?                @map("unit_of_measure")
  unitPrice         Decimal                @map("unit_price") @db.Decimal(14, 4)
  amount            Decimal                @db.Decimal(14, 2)
  sortOrder         Int                    @default(0) @map("sort_order")
  gdLines           GoodsDeclarationLine[]

  @@index([tradeInvoiceId])
  @@map("trade_invoice_lines")
}

// §4.5 — issued by the ocean carrier. Consignee and notify are free text because that is
// literally what the form carries ("To the order of BankIslami Pakistan Limited"); the
// structured parties behind them live in shipment_parties.
model BillOfLading {
  id                   String                  @id @default(uuid())
  referenceNo          String                  @unique @map("reference_no") // BL-YYYY-NNNNN
  shipmentId           String                  @unique @map("shipment_id")
  shipment             Shipment                @relation(fields: [shipmentId], references: [id])
  blNumber             String                  @map("bl_number")
  bookingNo            String?                 @map("booking_no")
  blType               BolType                 @default(master) @map("bl_type")
  carrierVendorId      String?                 @map("carrier_vendor_id")
  carrier              Vendor?                 @relation("BolCarrier", fields: [carrierVendorId], references: [id])
  carrierAgentVendorId String?                 @map("carrier_agent_vendor_id")
  carrierAgent         Vendor?                 @relation("BolCarrierAgent", fields: [carrierAgentVendorId], references: [id])
  shipperText          String?                 @map("shipper_text")
  consigneeText        String?                 @map("consignee_text")
  notifyText           String?                 @map("notify_text")
  secondNotifyText     String?                 @map("second_notify_text")
  vesselName           String?                 @map("vessel_name")
  voyageNo             String?                 @map("voyage_no")
  portOfLoading        String?                 @map("port_of_loading")
  portOfDischarge      String?                 @map("port_of_discharge")
  freightTerms         FreightTerms?           @map("freight_terms")
  // Setting this starts the DA clock: daDueDate = shippedOnBoard + FI.daDays (§7.2).
  shippedOnBoard       DateTime?               @map("shipped_on_board")
  issueDate            DateTime?               @map("issue_date")
  netWeightKg          Decimal?                @map("net_weight_kg") @db.Decimal(12, 3)
  grossWeightKg        Decimal?                @map("gross_weight_kg") @db.Decimal(12, 3)
  daNotifiedAt         DateTime?               @map("da_notified_at") // de-dupes the maturity sweep
  documentId           String?                 @map("document_id")
  notes                String?
  containers           BillOfLadingContainer[]
  logisticsInvoices    Invoice[]
  createdById          String?                 @map("created_by_id")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@map("bills_of_lading")
}

model BillOfLadingContainer {
  id             String            @id @default(uuid())
  billOfLadingId String            @map("bill_of_lading_id")
  billOfLading   BillOfLading      @relation(fields: [billOfLadingId], references: [id], onDelete: Cascade)
  containerId    String            @map("container_id")
  container      ShipmentContainer @relation(fields: [containerId], references: [id])

  @@unique([billOfLadingId, containerId])
  @@map("bill_of_lading_containers")
}

// §4.6 — the GD-I filed with Pakistan Customs through WeBOC by the clearing agent.
// Customs values are PKR, converted from the invoice currency at `exchangeRate`, which
// is why the rate is captured on the declaration itself (§7.2).
model GoodsDeclaration {
  id                    String                 @id @default(uuid())
  referenceNo           String                 @unique @map("reference_no") // GD-YYYY-NNNNN
  shipmentId            String                 @unique @map("shipment_id")
  shipment              Shipment               @relation(fields: [shipmentId], references: [id])
  gdNumber              String                 @map("gd_number")
  gdDate                DateTime?              @map("gd_date")
  clearingAgentVendorId String?                @map("clearing_agent_vendor_id")
  clearingAgent         Vendor?                @relation("GdClearingAgent", fields: [clearingAgentVendorId], references: [id])
  financialInstrumentId String?                @map("financial_instrument_id")
  financialInstrument   FinancialInstrument?   @relation(fields: [financialInstrumentId], references: [id])
  tradeInvoiceId        String?                @map("trade_invoice_id")
  tradeInvoice          TradeInvoice?          @relation(fields: [tradeInvoiceId], references: [id])
  portOfShipment        String?                @map("port_of_shipment")
  portOfDischarge       String?                @map("port_of_discharge")
  exchangeRate          Decimal?               @map("exchange_rate") @db.Decimal(12, 6)
  fobValuePkr           Decimal?               @map("fob_value_pkr") @db.Decimal(16, 2)
  freightPkr            Decimal?               @map("freight_pkr") @db.Decimal(16, 2)
  cfrValuePkr           Decimal?               @map("cfr_value_pkr") @db.Decimal(16, 2)
  insurancePkr          Decimal?               @map("insurance_pkr") @db.Decimal(16, 2)
  assessedValuePkr      Decimal?               @map("assessed_value_pkr") @db.Decimal(16, 2)
  appraiserName         String?                @map("appraiser_name") // the customs officer, NOT an app user
  examinerName          String?                @map("examiner_name")
  outOfChargeAt         DateTime?              @map("out_of_charge_at") // the release point
  filedAt               DateTime?              @map("filed_at")
  documentId            String?                @map("document_id")
  notes                 String?
  lines                 GoodsDeclarationLine[]
  logisticsInvoices     Invoice[]
  createdById           String?                @map("created_by_id")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("goods_declarations")
}

model GoodsDeclarationLine {
  id                 String            @id @default(uuid())
  goodsDeclarationId String            @map("goods_declaration_id")
  goodsDeclaration   GoodsDeclaration  @relation(fields: [goodsDeclarationId], references: [id], onDelete: Cascade)
  tradeInvoiceLineId String?           @map("trade_invoice_line_id")
  tradeInvoiceLine   TradeInvoiceLine? @relation(fields: [tradeInvoiceLineId], references: [id])
  hsCode             String            @map("hs_code")
  description        String
  quantity           Decimal           @default(1) @db.Decimal(14, 3)
  unitValue          Decimal?          @map("unit_value") @db.Decimal(14, 4)
  declaredValuePkr   Decimal?          @map("declared_value_pkr") @db.Decimal(16, 2)
  assessedValuePkr   Decimal?          @map("assessed_value_pkr") @db.Decimal(16, 2)
  sroCode            String?           @map("sro_code")
  sortOrder          Int               @default(0) @map("sort_order")

  @@index([goodsDeclarationId])
  @@map("goods_declaration_lines")
}

// The trail behind the derived tradeStage, mirroring shipment_status_history.
model ShipmentTradeStageHistory {
  id         String      @id @default(uuid())
  shipmentId String      @map("shipment_id")
  shipment   Shipment    @relation(fields: [shipmentId], references: [id])
  fromStage  TradeStage? @map("from_stage")
  toStage    TradeStage  @map("to_stage")
  actorId    String?     @map("actor_id")
  createdAt  DateTime    @default(now())

  @@index([shipmentId, createdAt])
  @@map("shipment_trade_stage_history")
}
