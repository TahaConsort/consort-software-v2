// =====================================================================
// Consort CRM — Prisma schema
// Source of truth: docs/DATABASE.md (subordinate to DECISIONS.md /
// BUSINESS_RULES.md). Every model/column serves a cited rule or ADR.
//
// NOTE: constraints Prisma cannot express (partial unique indexes for
// INV-05/07/08, services non-empty CHECKs, one-target CHECKs, the
// ADR-038 hold-pair CHECK, lower(email) unique) are applied in a raw
// SQL migration — see docs/DATABASE.md §5.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================

// Management tier (ceo..gm) holds identical permissions (ADR-044)
enum UserRole {
  ceo
  project_director
  director
  cfo
  gm
  hr
  asm
  bdo
  ops_manager
  ops_exec
  compliance_manager
  compliance_exec
  transport_manager
  transport_exec
  accounts
  customer
}

enum DepartmentCode {
  management
  sales
  operations
  compliance
  finance
  hr
  transport
}

// ADR-042 — immutable after creation (INV-13)
enum LeadSource {
  bdo
  bank_lc
  direct
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

enum OutreachType {
  call
  email
  meeting
  whatsapp
  linkedin
  site_visit
}

enum OutreachOutcome {
  positive
  neutral
  negative
  no_response
}

// ADR-043, WORKFLOW §2a
enum VisitPlanStatus {
  planned
  completed
  cancelled
  no_show
}

enum QueryStatus {
  open
  quoted
  revision_requested
  approved
  shipment_created
  rejected
  cancelled
  expired
}

enum RaisedVia {
  bdo
  portal
}

// Revisions are new rows, not a status (ADR-019)
enum QuotationStatus {
  draft
  sent
  approved
  rejected
  expired
}

enum ApprovalChannel {
  customer_portal
  asm
  management
}

// ADR-041 — the Phase-1 catalog, closed
enum ServiceCode {
  local_transport
  customs_clearance
  sea_freight
  port_handling
  lc_finance
  destination_services // destination agent: DO + gate pass, destination pickup, delivery, empty return
}

// The packages the business actually sells. Sits ABOVE ServiceCode: picking a
// package presets `services[]` (utils/servicePackage.js), so everything already keyed
// on ServiceCode — charge types, rate cards, P&L — is untouched. Needed as its own
// dimension because `local_transport`, `loading_point_to_port` and `port_to_consignee`
// share the `local_transport` service code yet require different step paths.
enum ServicePackage {
  local_transport // #1 inland trucking only — no port, no CRO, no customs, no trade-doc pack
  loading_point_to_port // #2 factory/loading point → port gate
  international // #3 full export path: CRO, customs, terminal, ocean freight, BL, telex
  // #4 the IMPORT leg, sold on its own: the box is already discharged and released, so
  // there is no CRO. The customer supplies BOL + delivery order + gate pass + free days;
  // we pull the container off the terminal, deliver to the consignee, return the empty.
  port_to_consignee
}

// Who obtains the Container Release Order. The sub-option on package #2; forced to
// `consort` on #3 and `not_applicable` on #1 and #4 (CHECK in prisma/sql/constraints.sql).
enum CroHandling {
  not_applicable // package #1 — no container, no CRO
  customer // customer supplies the CRO; we record their copy
  consort // we apply to the shipping line and obtain the CRO
}

// ADR-003 canonical codes, in canonical order. Expanded catalog (freight-forwarding OTC upgrade);
// `container_allocated` and `destination_inspection` are RETIRED from the seeded catalog but kept
// here so historical rows remain valid.
enum OtdStepCode {
  order_lock // canonical 1  — derives order_confirmed
  order_confirmed // canonical 2  — derives order_confirmed
  lc_generated // canonical 3
  container_allocated // RETIRED — superseded by vessel_booked
  cro_released // canonical 5
  cargo_pickup // canonical 7
  customs_entry // canonical 9
  inspected_sealed // canonical 10
  port_handover // canonical 11
  bol_issued // canonical 12
  bol_submitted // canonical 13
  telex_released // canonical 14
  destination_inspection // RETIRED — superseded by destination_pickup / destination_do
  delivered // canonical 17
  vessel_booked // canonical 4
  empty_container_pickup // canonical 6
  inland_transit // canonical 8
  destination_do // canonical 15
  destination_pickup // canonical 16
  empty_return // canonical 18 — derives status `delivered`
  // Service-package catalog (canonical numbers re-spaced to multiples of 10; see seed.js).
  // The pure-local trucking leg — no container, no port, no trade docs.
  transporter_assigned // canonical 22 — package local_transport
  vehicle_dispatched // canonical 24 — package local_transport
  goods_loaded // canonical 26 — package local_transport
  in_transit // canonical 28 — package local_transport
  local_delivered // canonical 172 — package local_transport terminal; derives status `delivered`
  cro_received_from_customer // canonical 50 — the croHandledBy=customer variant of cro_released
  port_job_completed // canonical 175 — package loading_point_to_port terminal; derives `delivered`
  // The import delivery leg (package port_to_consignee). Deliberately NOT the
  // destination_pickup/empty_return pair: those are the destination AGENT's steps on an
  // export job and sit with Operations, whereas this leg is our own trucks and is
  // Transport-owned end to end, like the local trucking package.
  import_container_pickup // canonical 152 — package port_to_consignee; derives `destination_pickup`
  import_empty_return // canonical 178 — package port_to_consignee terminal; derives `delivered`
  // canonical 95 — ONE customs step carrying filing, duty, examination and seal as
  // sub-actions (ADR-048). Supersedes customs_entry + inspected_sealed, which stay in
  // this enum (and as `active: false` template rows) so historical shipments still resolve.
  customs_clearance
}

// A step's sub-action is either ticked by its owner or satisfied by evidence.
// `document` actions are DERIVED, never written — satisfaction is the presence of a
// live document of that type on the shipment, exactly like RULE-SH-06 (ADR-048).
enum StepActionKind {
  manual
  document

  @@map("step_action_kind")
}

// reopen returns a step to pending (RULE-SH-05)
enum OtdStepStatus {
  pending
  done
}

// Progressive values; DERIVED, never written by an endpoint (ADR-014, INV-02).
// `container_allocated` / `destination_inspection` retained for historical rows (retired from the seed).
enum ShipmentStatus {
  booking
  order_confirmed
  lc_generated
  container_allocated
  vessel_booked
  cro_released
  transporter_assigned
  vehicle_dispatched
  goods_loaded
  in_transit
  empty_container_pickup
  cargo_pickup
  inland_transit
  customs_entry
  inspected_sealed
  port_handover
  bol_issued
  bol_submitted
  telex_released
  destination_inspection
  destination_do
  destination_pickup
  delivered
  settled
  closed
}

// Orthogonal to progress (RULE-SH-08)
enum ExceptionState {
  none
  on_hold
  cancelled
}

enum ExceptionType {
  customs_hold
  payment_hold
  documentation_hold
  weather_hold
  customer_request
